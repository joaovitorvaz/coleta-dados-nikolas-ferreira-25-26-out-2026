          {
            "id": "2114371200491106670",
            "text": "Acorda Brasil finalizou dia 25.01… e hoje dia é dia… Deus é perfeito.",
            "author_username": "nikolas_dm",
            "author_name": "nikolas_dm",
            "created_at": "2026-10-25T14:59:00+00:00",
            "permalink": "https://nitter.meowing.monster/nikolas_dm/status/2114371200491106670#m",
